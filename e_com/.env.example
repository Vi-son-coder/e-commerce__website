# PostgreSQL - Neon

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Server

PORT=3000
NODE_ENV=development

# JWT Authentication

JWT_SECRET=replace_with_your_own_secret
JWT_EXPIRES_IN=7d

# Admin

ADMIN_USERNAMES=admin

# Route protection

PROTECT_ROUTES=false

# CORS

CORS_ORIGIN=http://localhost:5173

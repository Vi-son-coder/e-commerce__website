DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ecommerce_db
DB_USER=ecommerce_app
DB_PASSWORD=change-me
# Used only by the Prisma CLI (prisma generate / db pull)
DATABASE_URL="sqlserver://localhost:1433;database=ecommerce_db;user=ecommerce_app;password=change-me;trustServerCertificate=true;encrypt=true"
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated usernames treated as admin (schema has no role column)
ADMIN_USERNAMES=admin
# true = require login/admin on the CRUD routes (see server.js)
PROTECT_ROUTES=false
# Comma-separated allowed origins; empty = allow all
CORS_ORIGIN=
